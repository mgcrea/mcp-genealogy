# ── Credentials ──────────────────────────────────────────────────────────────
# None. Everything this server reads is public: Geneanet's site-wide search
# and the family-tree API both answer anonymous requests. Private trees and
# Premium-only archive details are out of reach by design.

# ── Defaults ─────────────────────────────────────────────────────────────────
# The family tree the tree tools read when a call names none: the username in
# the tree's URL, gw.geneanet.org/<tree>. Leave empty to require `tree` on every
# call. geneanet_search_records returns this name on every family_tree hit.
GENEANET_TREE=

# Language of dates and event names in tree answers ("en", "fr", ...). With
# "en", numeric dates in tree search results are converted to ISO; other
# languages keep the site's own day/month order.
GENEANET_LANG=en

# ── Export ───────────────────────────────────────────────────────────────────
# The folder genealogy_export_gedcom writes its .ged files (and their
# .refs.json sidecars) to; nothing is ever written anywhere else. An absolute
# path or ~/...; created on first use. Defaults to
# ~/Library/Application Support/mcp-genealogy/exports. Point it at the folder
# granted in Filiation > Settings > MCP Server to let a Filiation agent read
# the exports.
GENEALOGY_EXPORT_DIR=

# ── Safety ───────────────────────────────────────────────────────────────────
# There is no write flag because no tool writes to a source; the only write is
# genealogy_export_gedcom's file, in GENEALOGY_EXPORT_DIR. Geneanet's terms
# forbid automated access, so requests are paced: never closer together than
# this many milliseconds, across all tools. Minimum 500, default 1000.
GENEANET_MIN_INTERVAL_MS=1000

# ── Optional tuning ──────────────────────────────────────────────────────────
# Retries for 429 / 5xx / network errors (0-5). Defaults to 2.
GENEANET_MAX_RETRIES=2

# Per-request deadline in milliseconds (5000-120000). Defaults to 20000; a timeout is not retried.
GENEANET_TIMEOUT_MS=20000

# Override the hosts (a proxy, or a test double).
GENEANET_TREE_API_URL=
GENEANET_SITE_URL=

# Set to 1 to log every request to stderr. GENEANET_DEBUG, the name from
# before the rename to mcp-genealogy, is still accepted.
GENEALOGY_DEBUG=
